# Local development environment — KEY NAMES with placeholder values.
# Copy to `.env.development.local` and fill in.
#
# Canonical names only. Legacy spellings (SUPABASE_SECRET_KEY,
# POSTGRES_URL, *_PUBLISHABLE_KEY, zepo_*) still resolve at runtime, but
# they are resolved in ONE place — src/lib/env.ts — and must not be used
# in new configuration. `pnpm check:env:contract` fails the build if an
# alias name reappears anywhere else.

# ============================================================
# REQUIRED — the app won't start without these.
# ============================================================

# Supabase (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Service-role key. Bypasses RLS, so it is used only by server-only
# modules (the WhatsApp webhook, the flows engine, the public API-key
# auth path — see docs/public-api.md), and every one of them must still
# scope its queries by account_id.
#
# The public API (/api/v1) needs no additional variable: API keys are
# created in Settings → API keys and stored hashed; this key is what
# lets the auth path look a presented key up without a user session.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Postgres connection string for local dev and CI. In production this is
# absent by design — SQL goes through the Cloudflare HYPERDRIVE binding
# (src/lib/db/client.ts). Use the DIRECT connection string, not the
# Supavisor transaction pooler (:6543), unless you know you want
# prepared statements disabled.
DATABASE_URL=postgresql://postgres:password@localhost:5432/postgres

# Third-party credential encryption (64 hex chars = 32 bytes, AES-256-GCM).
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Rotating this orphans every token encrypted under the previous key —
# tenants have to re-save their channel settings to reconnect.
ENCRYPTION_KEY=your-64-char-hex-key-here

# ============================================================
# RECOMMENDED — safe defaults exist, but set these deliberately.
# ============================================================

# Canonical public origin (scheme + host, no trailing slash).
# Production value: https://auxelon.in
#
# Used for the sitemap, OG images, and any link generated where there is
# no incoming request to derive an origin from (cron jobs, background
# workers). Request-bound routes derive their own origin.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Default UI locale (e.g. en)
NEXT_PUBLIC_APP_LOCALE=en

# Port for the Next.js dev server. ONE process — the separate Express
# API and its API_HOST/API_PORT/EXPRESS_API_URL variables were removed.
WEB_PORT=3000

# ============================================================
# OPTIONAL — only needed for the specific feature named.
# ============================================================

# ── Cron authorization (two secrets, two transports) ──
# Platform schedulers send `Authorization: Bearer $CRON_SECRET`; an
# external pinger sends `x-cron-secret: $AUTOMATION_CRON_SECRET`. Each
# secret is accepted only in its own transport, so a leak in one channel
# cannot authorize the other. Generate either with `openssl rand -hex 32`.
# CRON_SECRET=generate-a-long-random-string
# AUTOMATION_CRON_SECRET=generate-a-long-random-string

# ── Upstash Redis (rate limiting, read-through cache, concurrency guard) ──
# Both halves or neither: a URL with no token is treated as unconfigured,
# and the guards degrade to in-memory (single-isolate) behaviour.
# KV_REST_API_URL=
# KV_REST_API_TOKEN=

# ── Meta / WhatsApp Cloud API (app-level identifiers) ──
# Per-tenant WhatsApp credentials are configured in-app and stored
# encrypted, so these are NOT required to run the product. Without them
# webhook signature verification fails closed and image-header template
# submission returns a clear error; everything else is unaffected.
# META_APP_ID=your-meta-app-id
# META_APP_SECRET=your-meta-app-secret

# When "true", POST /api/whatsapp/templates/submit skips the Meta call and
# stores a synthetic `dry-run-<uuid>` meta_template_id. Set in CI and local
# dev to exercise the template UI without a real WABA. Never in production.
# WHATSAPP_TEMPLATES_DRY_RUN=true

# ── Email delivery (invites fall back to logging the link when unset) ──
# RESEND_API_KEY=
# EMAIL_FROM=
# MAILTRAP_API_TOKEN=
# MAILTRAP_FROM_EMAIL=
# INVITE_DELIVERY_MODE=log

# Defense-in-depth allow-list of hostnames /api/account/invitations may
# publish in invite URLs (comma-separated, hostnames only). When
# NEXT_PUBLIC_SITE_URL is set, invite links are already pinned to it and
# this is unnecessary; it exists for bare deployments where a spoofed
# `Host` header could otherwise steer an invite link at an attacker.
# ALLOWED_INVITE_HOSTS=crm.example.com,crm-staging.example.com

# Supabase auth redirect override for v0 preview environments only.
# NEXT_PUBLIC_DEV_SUPABASE_REDIRECT_URL=

# ── AI reply assistant ──
# Bring-your-own-key: each account pastes its own provider key under
# Settings → AI Assistant, stored AES-256-GCM-encrypted with
# ENCRYPTION_KEY. There is NO global provider key, and nothing here is
# required for the feature to work — the vars below only tune behaviour.
# AI_REQUEST_TIMEOUT_MS=30000
# AI_CONTEXT_MESSAGE_LIMIT=20

# Which assistant engine implementation to use (see
# src/features/assistant/lib/ai/engine-flag.ts).
# AI_ENGINE=

# Shared Gemini key used ONLY as a last-resort fallback when an account
# has configured no key of its own. Leave unset in multi-tenant
# deployments — one shared key means one shared quota and one shared
# bill. The planned replacement is the Cloudflare Workers AI binding
# (see wrangler.jsonc), which needs no key at all.
# GEMINI_API_KEY=

# Base URL of a self-hosted Ollama instance, for local model testing.
# OLLAMA_BASE_URL=http://127.0.0.1:11434

# ── Channel onboarding (Settings → Channels connection cards) ──
# Meta Embedded Signup configuration id. Paired with META_APP_ID; when
# either is absent the WhatsApp card renders as "not configured" instead
# of offering the guided signup flow.
# META_SIGNUP_CONFIG_ID=

# Twilio Connect App SID. When absent, the Twilio card hides its
# authorize link; per-tenant Twilio credentials are configured in-app.
# TWILIO_CONNECT_APP_SID=

# ── Localization ──
# IANA time zone used to render dates when an account has no preference
# (src/i18n/request.ts). Defaults to UTC.
# NEXT_PUBLIC_APP_TIME_ZONE=Asia/Kolkata

# ── Platform console ──
# Comma-separated operator emails granted the super-admin console.
# SUPER_ADMIN_EMAILS=

# ── Observability (every adapter no-ops when its vars are absent) ──
# LOG_LEVEL=info
# LOKI_URL=
# LOKI_TOKEN=
# SENTRY_DSN=
# LANGFUSE_PUBLIC_KEY=
# LANGFUSE_SECRET_KEY=
# LANGFUSE_BASE_URL=
# NEXT_PUBLIC_CF_ANALYTICS_TOKEN=

# ── Release identity (injected by the promotion workflow, not by hand) ──
# RELEASE_VERSION=
# GIT_SHA=
