# Production environment manifest — KEY NAMES ONLY, NEVER VALUES.
# (plan Task 4 Step 5; validated by scripts/check-env-completeness.mjs)
#
# Conventions:
#   KEY=     required in production (promotion fails without it)
#   # KEY=   optional — env-gated feature that no-ops when absent
#
# Real values live ONLY in:
#   - Cloudflare Worker secrets (runtime)
#   - GitHub Environments: `production` / `db-production` (CI)
# Never commit a value to this file.

# ── Supabase (Auth / Storage / Realtime — SQL goes through Hyperdrive) ──
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ── App ──
NEXT_PUBLIC_SITE_URL=
ENCRYPTION_KEY=
CRON_SECRET=

# ── Optional: Meta / WhatsApp Cloud API (app-level identifiers) ──
# NOT required to promote. Per-tenant WhatsApp credentials are configured
# in-app and stored encrypted (src/lib/crypto/secrets.ts); these two are
# the app-level Meta identifiers. Absent them, webhook signature
# verification fails CLOSED and image-header template submission returns
# a clear error — every other channel is unaffected. Set them when a Meta
# app exists.
# META_APP_ID=
# META_APP_SECRET=

# ── Upstash Redis (rate limiting, cache, concurrency guard) ──
KV_REST_API_URL=
KV_REST_API_TOKEN=

# ── Optional: payments (ADR-009) ──
# NOT required to promote: with nothing set, every payments surface fails
# closed through NoopPaymentProvider. Partial config is treated as NO
# config — a key id without a webhook secret could take real money while
# being structurally unable to verify the webhook that grants access.
#
# PAYMENTS_ENVIRONMENT is configured, never inferred. Absent or
# unrecognised (while PAYMENTS_PROVIDER is set) disables payments rather
# than guessing: 'test' would make live webhooks unverifiable, 'live'
# would let sandbox events grant real access.
# PAYMENTS_PROVIDER=
# PAYMENTS_ENVIRONMENT=
#
# Only the set matching PAYMENTS_ENVIRONMENT is loaded. The three
# credentials are required together. *_ACCOUNT_ID enables the signed
# account-consistency check and is REQUIRED at go-live.
# RAZORPAY_LIVE_KEY_ID=
# RAZORPAY_LIVE_KEY_SECRET=
# RAZORPAY_LIVE_WEBHOOK_SECRET=
# RAZORPAY_LIVE_ACCOUNT_ID=
#
# Set ONLY during a webhook-secret rotation, then removed once no
# retries still rely on the old secret (Razorpay's retry window is 24h).
# RAZORPAY_LIVE_WEBHOOK_SECRET_PREVIOUS=
#
# Test credentials are nameable here too, so the go-live rehearsal needs
# no code change — only a PAYMENTS_ENVIRONMENT flip.
# RAZORPAY_TEST_KEY_ID=
# RAZORPAY_TEST_KEY_SECRET=
# RAZORPAY_TEST_WEBHOOK_SECRET=
# RAZORPAY_TEST_ACCOUNT_ID=
# RAZORPAY_TEST_WEBHOOK_SECRET_PREVIOUS=

# ── Optional: observability (adapters no-op when absent — NFR-003) ──
# LOKI_URL=
# LOKI_TOKEN=
# SENTRY_DSN=
# LANGFUSE_PUBLIC_KEY=
# LANGFUSE_SECRET_KEY=
# LANGFUSE_BASE_URL=

# ── Optional: Cloudflare Web Analytics (browser analytics token) ──
# NEXT_PUBLIC_CF_ANALYTICS_TOKEN=

# ── Optional: release identity (injected by the promotion workflow) ──
# RELEASE_VERSION=
# GIT_SHA=

# ── Dev/CI only — NOT set in production (production SQL uses the
#    HYPERDRIVE binding; see src/lib/db/client.ts) ──
# DATABASE_URL=
